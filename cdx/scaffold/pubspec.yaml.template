# INACTIVE TEMPLATE. Resolve exact SDK/tool versions during scaffold activation.
name: dura_workspace
publish_to: none
environment:
  sdk: REPLACE_WITH_VALIDATED_DART_RANGE
workspace:
  - apps/dura
  - packages/dura_core
  - packages/dura_data
  - packages/dura_ui
  - packages/dura_fiscal
dev_dependencies:
  melos: REPLACE_WITH_EXACT_VALIDATED_MELOS_VERSION
melos:
  scripts:
    verify:
      description: Required format, analysis, generation, architecture, tests and sample checks.
      run: dart run tool/ci/verify.dart
    test:core:
      run: dart run tool/test.dart core
    test:contracts:
      run: dart run tool/test.dart contracts
    test:widgets:
      run: dart run tool/test.dart widgets
    test:goldens:
      run: dart run tool/test.dart goldens
    test:migrations:
      run: dart run tool/test.dart migrations
    test:sync:
      run: dart run tool/test.dart sync
    test:android:
      run: dart run tool/ci/android_integration.dart
    schema:check:
      run: dart run tool/schema_check.dart
    samples:check:
      run: dart run tool/sample_check.dart
